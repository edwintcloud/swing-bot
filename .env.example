# Docker Compose reads the IB login name here. Put the password only in
# secrets/tws_password.txt, which is excluded from version control.
TWS_USERID=replace-with-ib-username

# Runtime node settings. A paper account starts with DU.
TRADING_MODE=paper
TWS_ACCOUNT=DU0000000
IB_HOST=127.0.0.1
IB_PORT=4002
IB_DATA_CLIENT_ID=20
IB_EXEC_CLIENT_ID=30

VNC_SERVER_PASSWORD=password

# Required only for the live command. Keep blank for paper operation.
LIVE_TRADING_ACK=

# Dashboard binds to localhost port 80. Leave the password blank for local-only access,
# or set one to enable HTTP Basic authentication.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Optional Telegram notifications. Create a bot with BotFather, then provide the target
# user or group chat ID. Both values are required to enable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=